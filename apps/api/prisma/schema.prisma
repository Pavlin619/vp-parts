generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CustomerRole {
  CUSTOMER
  MECHANIC
}

enum MechanicApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CartStatus {
  ACTIVE
  MERGED
  ORDERED
}

enum OrderStatus {
  PROCESSING
  ITEMS_PREPARED
  ON_THE_WAY
  DELIVERED
  CANCELLED
  FULFILLMENT_FAILED
}

enum ShippingMethod {
  ECONT
  SPEEDY
}

enum DeliveryMethod {
  COURIER_OFFICE
  COURIER_ADDRESS
  STORE_PICKUP
}

enum PaymentMethod {
  CARD
  CASH_ON_DELIVERY
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Customer {
  id          String       @id @default(uuid())
  clerkId     String       @unique
  email       String       @unique
  /// Null until given: a customer is filed before their profile is complete — see docs/AUTH.md.
  firstName   String?
  lastName    String?
  /// A Bulgarian mobile in E.164. Never verified by SMS — see docs/AUTH.md.
  phoneNumber String?
  role        CustomerRole @default(CUSTOMER)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  mechanicProfile MechanicProfile?
  addresses       Address[]
  carts           Cart[]
  orders          Order[]
  savedVehicles   SavedVehicle[]
}

model MechanicProfile {
  id              String                 @id @default(uuid())
  customerId      String                 @unique
  businessName    String
  eik             String                 @unique
  vatNumber       String?
  businessAddress String
  businessPhone   String
  status          MechanicApprovalStatus @default(PENDING)
  rejectionReason String?
  appliedAt       DateTime               @default(now())
  reviewedAt      DateTime?

  customer Customer @relation(fields: [customerId], references: [id])
}

/// A place a customer keeps on file to have parcels delivered to. Shaped like
/// the carrier's own address, because `placeId` is that carrier's settlement id
/// and means nothing to another one.
model Address {
  id           String         @id @default(uuid())
  customerId   String
  carrier      ShippingMethod
  placeId      String
  city         String
  postCode     String
  street       String?
  streetNumber String?
  quarter      String?
  block        String?
  entrance     String?
  floor        String?
  apartment    String?
  note         String?
  isDefault    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

/// A cart belongs to a guest (`token`) or to a customer (`customerId`), never
/// both. It is never deleted once it has been ordered from: an ordered cart is
/// the record of what was bought, and `orderId` is what makes a retried payment
/// webhook idempotent.
model Cart {
  id           String     @id @default(uuid())
  /// Guest owner. Cleared once a customer claims the cart.
  token        String?    @unique
  customerId   String?
  status       CartStatus @default(ACTIVE)
  /// Raised by every mutation. Checkout pins the version it priced, so an order
  /// can refuse a cart that moved between the quote and the commitment.
  version      Int        @default(0)
  /// Where this cart's lines went when it was merged into another.
  mergedIntoId String?
  orderId      String?    @unique
  /// Guest carts are swept after this; a customer's cart does not expire.
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customer        Customer?  @relation(fields: [customerId], references: [id])
  items           CartItem[]
  /// The cart this one's lines were merged into. Self-relation, so a merge
  /// target that never existed is refused by the database, not discovered later.
  mergedInto      Cart?      @relation("CartMerge", fields: [mergedIntoId], references: [id])
  mergedFrom      Cart[]     @relation("CartMerge")
  /// This cart's own record of the order it produced — the idempotency check
  /// a retried checkout call reads. `Restrict`, not the default `SetNull`: an
  /// order is never deleted, so this FK exists to refuse a bad delete loudly,
  /// not to survive one by quietly forgetting which order this cart produced.
  order           Order?     @relation("CartOrderRecord", fields: [orderId], references: [id], onDelete: Restrict)
  recordedByOrder Order?     @relation("OrderCartRecord")

  @@index([status, customerId, expiresAt])
}

/// Intent, not valuation. The catalog fields are a snapshot of what the
/// customer saw; price and stock are read live on every cart surface. The one
/// stored figure, `addedAtPriceIncVat`, exists to be compared against the live
/// price and is never shown as the price.
model CartItem {
  id                  String   @id @default(uuid())
  cartId              String
  /// TecDoc `dataSupplierId`. An article number alone does not identify a part.
  brandId             String
  articleNumber       String
  brandName           String
  brandLogoUrl        String?
  description         String
  thumbnailUrl        String?
  quantity            Int
  isSelected          Boolean  @default(true)
  addedAtPriceIncVat  Int?
  /// The part's weight and packed size, resolved when the line was added so
  /// checkout can weigh the cart without calling TecDoc. Null where no source knows.
  weightGrams         Int?
  packageLengthCm     Float?
  packageWidthCm      Float?
  packageHeightCm     Float?
  /// True when any of the above was estimated from equivalent parts rather than
  /// measured. An estimated line never goes to a locker.
  isShippingEstimated Boolean  @default(false)
  addedAt             DateTime @default(now())
  updatedAt           DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, brandId, articleNumber])
}

/// What a TecDoc product type typically weighs and packs into: the last resort
/// when no source knows a part's own weight. Rebuilt wholesale by
/// `npm run parcel-profiles:build`, never edited by hand.
model ProductTypeParcelProfile {
  genericArticleId Int      @id
  productTypeName  String
  weightGrams      Int
  packageLengthCm  Float?
  packageWidthCm   Float?
  packageHeightCm  Float?
  /// How many weighed parts the figures were taken from.
  sampleSize       Int
  computedAt       DateTime
}

/// Every amount is EUR cents including VAT, frozen when the order is placed:
/// the customer pays exactly these figures — see docs/ORDERS.md.
model Order {
  id                   String          @id @default(uuid())
  /// `VP-ORD-000123`, numbered from the `order_reference_seq` sequence.
  orderReference       String          @unique
  customerId           String
  /// The cart this order was placed from. Unique, so the database itself
  /// refuses a second order for one cart — that is the idempotency key a
  /// retried order request is checked against.
  cartId               String?         @unique
  status               OrderStatus     @default(PROCESSING)
  deliveryMethod       DeliveryMethod
  /// Null for store pickup.
  carrier              ShippingMethod?
  /// The destination as the customer chose it: the office, or the address.
  deliverySnapshot     Json
  expectedDeliveryDate DateTime?       @db.Date
  parcelWeightGrams    Int?
  goodsTotal           Int
  deliveryPrice        Int
  cashOnDeliveryFee    Int
  total                Int
  vatAmount            Int
  paymentMethod        PaymentMethod
  paymentReference     String?
  /// Copied from the profile, so a later profile edit never rewrites an order.
  contactFirstName     String
  contactLastName      String
  contactPhone         String
  contactEmail         String
  /// Which terms the customer ordered under.
  termsVersion         String
  trackingReference    String?
  vehicleTag           String?
  jobReference         String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  customer       Customer             @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  /// `Restrict`, not the default `SetNull`: the guest-cart sweep already
  /// excludes ordered carts by `status` and `orderId`, but if that invariant
  /// were ever broken, this FK must block the delete, not silently orphan the
  /// order's idempotency key.
  cart           Cart?                @relation("OrderCartRecord", fields: [cartId], references: [id], onDelete: Restrict)
  recordedByCart Cart?                @relation("CartOrderRecord")

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id            String @id @default(uuid())
  orderId       String
  /// TecDoc `dataSupplierId` — the other half of the article's identity.
  brandId       String
  articleNumber String
  brandName     String
  description   String
  thumbnailUrl  String?
  quantity      Int
  /// Gross, including VAT. `lineTotal` is `unitPrice × quantity`, never rounded.
  unitPrice     Int
  lineTotal     Int

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model OrderStatusHistory {
  id         String      @id @default(uuid())
  orderId    String
  status     OrderStatus
  occurredAt DateTime    @default(now())
  source     String

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model SavedVehicle {
  id              String   @id @default(uuid())
  customerId      String
  tecdocVehicleId String
  manufacturer    String
  modelSeries     String
  variant         String
  addedAt         DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, tecdocVehicleId])
  @@index([customerId])
}
